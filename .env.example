# Application
APP_NAME=Paharpur ECR
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
# Private signature storage; production: an absolute persistent/shared directory.
STORAGE_ROOT=var/protected

# Authentication and server-side sessions
SESSION_COOKIE_NAME=ecr_session
SESSION_TTL_DAYS=30
SESSION_SECURE_COOKIE=false
SESSION_TOUCH_INTERVAL_SECONDS=300
CSRF_COOKIE_NAME=ecr_csrf
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# MySQL 8.x
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecr_dev
DB_USER=ecr_dev
DB_PASSWORD=replace-with-local-password
DB_CHARSET=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_ECHO=false
