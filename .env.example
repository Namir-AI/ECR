# Application
APP_NAME=Paharpur ECR
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# MySQL 8.x
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecr_dev
DB_USER=ecr_dev
DB_PASSWORD=replace-with-local-password
DB_CHARSET=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_ECHO=false
